rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is signed in and owns the document they are trying to read/update/delete
    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.user_id;
    }
    
    // Check if the user is signed in and is setting their own user_id when creating a document
    function isOwnerOnCreate() {
      return request.auth != null && request.auth.uid == request.resource.data.user_id;
    }

    // Apply this rule to all collections nested under this database
    match /{collection}/{document=**} {
      allow read, update, delete: if isOwner();
      allow create: if isOwnerOnCreate();
    }
  }
}
